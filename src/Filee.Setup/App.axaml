<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Filee.Setup.App"
             Name="Filee Setup"
             RequestedThemeVariant="Default">
  <!-- Light or dark follows Windows (RequestedThemeVariant="Default"), like Filee's "System" theme. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Filee.Setup/Styles/Soft.axaml" />
    <StyleInclude Source="avares://Filee.Setup/Styles/Setup.axaml" />
  </Application.Styles>
</Application>
