<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.MergeOrderWindow"
        x:DataType="vm:MergeOrderViewModel"
        Title="{DynamicResource merge.order_title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="600" Height="480" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
    <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
  </Window.KeyBindings>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
      <TextBlock Classes="h2" Text="{DynamicResource merge.order_title}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource merge.order_hint}" />
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="MoveUp" Content="↑" Command="{Binding MoveUpCommand}"
                AutomationProperties.Name="{DynamicResource group.move_up}"
                ToolTip.Tip="{DynamicResource group.move_up}" />
        <Button x:Name="MoveDown" Content="↓" Command="{Binding MoveDownCommand}"
                AutomationProperties.Name="{DynamicResource group.move_down}"
                ToolTip.Tip="{DynamicResource group.move_down}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelMerge" Content="{DynamicResource common.cancel}" Click="OnCancel" IsCancel="True" />
        <Button x:Name="StartMerge" Classes="accent" Content="{DynamicResource preset.merge_pdf}" Click="OnMerge" IsDefault="True" />
      </StackPanel>
    </Grid>
    <ListBox x:Name="FileOrder" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MergeSource">
          <StackPanel Spacing="2" Margin="4,6" ToolTip.Tip="{Binding Path}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="caption" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
