<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             xmlns:settings="using:Filee.Core.Settings"
             x:Class="Filee.App.Views.Pages.ThemePage"
             x:DataType="vm:ThemePageViewModel">
  <Grid ColumnDefinitions="*,24,340" RowDefinitions="Auto,Auto">
    <TextBlock Grid.ColumnSpan="3" Classes="h1" Text="{DynamicResource theme.title}" Margin="0,0,0,18" />

    <StackPanel Grid.Row="1" Spacing="16">
      <!-- Theme Style: Filee Soft vs Google Material You (M3) -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <DockPanel>
            <Border DockPanel.Dock="Right" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}" Padding="8,2"
                    IsVisible="{Binding IsMaterialYou}">
              <TextBlock Text="Material 3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrongBrush}" />
            </Border>
            <TextBlock Classes="label" Text="{DynamicResource theme.style}" VerticalAlignment="Center" Margin="0" />
          </DockPanel>

          <Grid ColumnDefinitions="*,12,*" RowDefinitions="1*">
            <!-- Filee Soft Choice Card -->
            <Button Classes="choice-card"
                    Classes.selected="{Binding !IsMaterialYou}"
                    Command="{Binding SetStyleCommand}"
                    CommandParameter="{x:Static settings:ThemeStyle.Soft}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
              <StackPanel Spacing="6" VerticalAlignment="Top">
                <TextBlock Classes="choice-title" Text="{DynamicResource theme.style.Soft}" />
                <TextBlock Classes="choice-desc" Text="{DynamicResource theme.style.soft_hint}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>

            <!-- Material You Choice Card -->
            <Button Grid.Column="2"
                    Classes="choice-card"
                    Classes.selected="{Binding IsMaterialYou}"
                    Command="{Binding SetStyleCommand}"
                    CommandParameter="{x:Static settings:ThemeStyle.MaterialYou}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
              <StackPanel Spacing="6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="choice-title" Text="{DynamicResource theme.style.MaterialYou}" />
                  <Border CornerRadius="999" Background="{DynamicResource AccentBrush}" Padding="6,1">
                    <TextBlock Text="M3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Classes="choice-desc" Text="{DynamicResource theme.style.material_you_hint}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Appearance Mode: System / Light / Dark -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{DynamicResource theme.mode}" />
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="220" />
        </StackPanel>
      </Border>

      <!-- Accent Color & Dynamic Tonal Palette -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="label" Text="{DynamicResource theme.accent}" />

          <!-- Inkora Curated Pastel Presets -->
          <DockPanel Margin="0,4,0,0">
            <Border DockPanel.Dock="Right" CornerRadius="999" Background="{DynamicResource AccentSoftBrush}" Padding="8,2">
              <TextBlock Text="Inkora Collection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrongBrush}" />
            </Border>
            <TextBlock Classes="caption" Text="Curated Pastel Themes" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding InkoraPresets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemePageViewModel+InkoraPresetItem">
                <Button Classes="preset-pill" Margin="0,0,6,6"
                        Command="{Binding $parent[ItemsControl].((vm:ThemePageViewModel)DataContext).PickInkoraPresetCommand}"
                        CommandParameter="{Binding}">
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="999" Margin="0,0,8,0"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                      <Border.Background>
                        <SolidColorBrush Color="{Binding ActiveColor}" />
                      </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Standard / Vibrant Seeds -->
          <TextBlock Classes="caption" Text="Vibrant &amp; Signature Swatches" FontWeight="SemiBold" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding StandardSwatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="Color">
                <Button Classes="swatch" Margin="0,0,8,8"
                        Command="{Binding $parent[ItemsControl].((vm:ThemePageViewModel)DataContext).PickSwatchCommand}"
                        CommandParameter="{Binding}" ToolTip.Tip="{Binding}">
                  <Button.Background>
                    <SolidColorBrush Color="{Binding}" />
                  </Button.Background>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Custom color row -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
            <Border Width="32" Height="32" CornerRadius="999" Background="{Binding AccentBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" />
            <TextBlock Classes="label" VerticalAlignment="Center" Text="{DynamicResource theme.custom_color}" Margin="0" />
            <TextBox Text="{Binding AccentHex}" Width="120" PlaceholderText="#7F77DD" />
          </StackPanel>

          <!-- Dynamic Tonal Harmony preview for Material You -->
          <StackPanel Spacing="6" Margin="0,6,0,0" IsVisible="{Binding IsMaterialYou}">
            <TextBlock Classes="caption" Text="{DynamicResource theme.tonal_palette}" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,4,*,4,*,4,*,4,*">
              <Border Height="28" CornerRadius="8,0,0,8" Background="{Binding TonalPrimary}" ToolTip.Tip="Primary" />
              <Border Grid.Column="2" Height="28" Background="{Binding TonalPrimaryContainer}" ToolTip.Tip="Primary Container" />
              <Border Grid.Column="4" Height="28" Background="{Binding TonalSecondaryContainer}" ToolTip.Tip="Secondary Container" />
              <Border Grid.Column="6" Height="28" Background="{Binding TonalSurfaceContainer}" ToolTip.Tip="Surface Container" />
              <Border Grid.Column="8" Height="28" CornerRadius="0,8,8,0" Background="{Binding TonalSurface}" ToolTip.Tip="Surface" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Softness / Corner Radius -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding CornerRadius, StringFormat={}{0:0}}" />
            <TextBlock Classes="label" Text="{DynamicResource theme.corner_radius}" />
          </DockPanel>
          <Slider Minimum="0" Maximum="28" Value="{Binding CornerRadius}" TickFrequency="1" IsSnapToTickEnabled="True" />
        </StackPanel>
      </Border>

      <!-- Donut Toolbar Transparency / Opacity (10% to 100%) -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding DonutOpacity, StringFormat={}{0:0}%}" />
            <TextBlock Classes="label" Text="Donut toolbar transparency" />
          </DockPanel>
          <Slider Minimum="10" Maximum="100" Value="{Binding DonutOpacity}" TickFrequency="5" IsSnapToTickEnabled="True" />
        </StackPanel>
      </Border>

      <!-- Motion / Animations -->
      <Border Classes="card">
        <StackPanel Spacing="4">
          <CheckBox Content="{DynamicResource theme.reduce_motion}" IsChecked="{Binding ReduceMotion}" FontWeight="SemiBold" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{DynamicResource theme.reduce_motion_hint}" Margin="28,0,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Live preview -->
    <Border Grid.Row="1" Grid.Column="2" Classes="card" VerticalAlignment="Top">
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="{DynamicResource theme.preview}" />
        <c:DonutMenu x:Name="PreviewDonut"
                     Items="{Binding PreviewItems}"
                     OuterRadius="120"
                     CenterTitle="JPG × 3"
                     CenterSubtitle="3 files"
                     SliceOpacity="{Binding DonutSliceOpacity}"
                     HorizontalAlignment="Center"
                     IsMaterialYou="{Binding IsMaterialYou}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Classes="accent" Content="{DynamicResource common.save}" />
          <Button Content="{DynamicResource common.cancel}" />
        </StackPanel>
        <Slider Value="60" Maximum="100" />
        <ToggleSwitch IsChecked="True" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
