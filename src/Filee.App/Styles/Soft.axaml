    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_IncreaseButton /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_IncreaseButton /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_DecreaseButton /template/ ContentPresenter#PART_ContentPresenter,
                   Window.material-you ButtonSpinner /template/ RepeatButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_IncreaseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_DecreaseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_IncreaseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_DecreaseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Window.material-you ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover,
                   ButtonSpinner:right /template/ RepeatButton:pointerover,
                   ButtonSpinner:right /template/ RepeatButton#PART_IncreaseButton:pointerover,
                   ButtonSpinner:right /template/ RepeatButton#PART_DecreaseButton:pointerover,
                   ButtonSpinner /template/ RepeatButton#PART_IncreaseButton:pointerover,
                   ButtonSpinner /template/ RepeatButton#PART_DecreaseButton:pointerover,
                   Window.material-you ButtonSpinner /template/ RepeatButton:pointerover">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_IncreaseButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner:right /template/ RepeatButton#PART_DecreaseButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_IncreaseButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   ButtonSpinner /template/ RepeatButton#PART_DecreaseButton:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Window.material-you ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
