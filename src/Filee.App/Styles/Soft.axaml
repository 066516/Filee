<!--
  Filee "soft" look: rounded corners, gentle surfaces, springy press feedback.
  Colours that depend on light/dark live in ThemeDictionaries below; the accent colour, corner radii and
  the UI font are written at runtime by ThemeService (so users can customise them).
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#F6F5F1" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EFEDE6" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#16000000" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1E1D" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6A66" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C73A39" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#0F7A5A" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9A5B0C" />
          <BoxShadows x:Key="CardShadow">0 1 3 0 #12000000, 0 6 18 0 #0D000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#1B1B19" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#262624" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#31312E" />
          <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1CFFFFFF" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1EFE8" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEACA4" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F09595" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#5DCAA5" />
          <SolidColorBrush x:Key="WarningBrush" Color="#EF9F27" />
          <BoxShadows x:Key="CardShadow">0 1 3 0 #40000000, 0 8 24 0 #33000000</BoxShadows>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Defaults; ThemeService overwrites these at startup. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#7F77DD" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E7F77DD" />
      <SolidColorBrush x:Key="AccentFaintBrush" Color="#177F77DD" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#5F59A6" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <CornerRadius x:Key="SoftRadius">16</CornerRadius>
      <CornerRadius x:Key="SoftRadiusSmall">9</CornerRadius>
      <CornerRadius x:Key="SoftRadiusLarge">22</CornerRadius>
      <FontFamily x:Key="AppFontFamily">Segoe UI, Malgun Gothic, Microsoft YaHei, sans-serif</FontFamily>

      <!-- Springy easing used by press/hover transitions ("말랑말랑"). -->
      <BackEaseOut x:Key="SoftEase" />
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ───────── Windows & typography ───────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- ───────── Cards ───────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Cursor" Value="SizeAll" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.chip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>

  <!-- Badge for engine status etc. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="Border.badge.ok">
    <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
  </Style>

  <!-- ───────── Buttons: soft corners and a springy press ───────── -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pressed, ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.95)" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Small links at the bottom of the navigation (GitHub, Sponsor) -->
  <Style Selector="Button.navlink">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Choice Cards (Theme Style, Format cards) -->
  <Style Selector="Button.choice-card">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="MinHeight" Value="115" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.choice-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.choice-card.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="Button.choice-card TextBlock.choice-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.choice-card.selected TextBlock.choice-title">
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.choice-card TextBlock.choice-desc">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="LineHeight" Value="17" />
  </Style>
  <Style Selector="Button.choice-card.selected TextBlock.choice-desc">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ───────── Progress bars / Loaders ───────── -->
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>
  <Style Selector="ProgressBar.soft">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
  </Style>

  <!-- ───────── Seekbars / Sliders ───────── -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Slider:horizontal">
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Slider:horizontal /template/ Border#TrackBackground">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton /template/ Border">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton /template/ Border">
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Slider:horizontal /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider:horizontal /template/ Thumb#PART_Thumb:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.18)" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- ───────── Navigation list ───────── -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadiusSmall}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="translateX(3px)" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Generic rounded list items (profiles, presets) -->
  <Style Selector="ListBox.soft">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="2,1,6,1" />
  </Style>
  <Style Selector="ListBox.soft ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- ───────── Donut control colours ───────── -->
  <Style Selector="c|DonutMenu">
    <Setter Property="SliceBrush" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="SliceBorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
    <Setter Property="CenterBrush" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="OnAccentBrush" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SecondaryForeground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="DangerBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="SuccessBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- ───────── Material You (M3) design system ───────── -->

  <!-- Typography & Headings -->
  <Style Selector="Window.material-you TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Window.material-you TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.material-you TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!-- Cards: M3 elevated tonal surface, 20px corners, non-clipping -->
  <Style Selector="Window.material-you Border.card">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <!-- Navigation items -->
  <Style Selector="Window.material-you ListBox.nav ListBoxItem">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.material-you ListBox.nav ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Window.material-you ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.material-you ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- List tiles (Presets, Profiles, Suggestions) -->
  <Style Selector="Window.material-you ListBox.soft ListBoxItem">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="2,2,6,2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.material-you ListBox.soft ListBoxItem:pointerover">
    <Setter Property="RenderTransform" Value="translateX(2px)" />
  </Style>
  <Style Selector="Window.material-you ListBox.soft ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.material-you ListBox.soft ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- DropZone tile: dark tonal surface with subtle border -->
  <Style Selector="Window.material-you Border#DropZone">
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="28,24" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>
  <Style Selector="Window.material-you Border#DropZone.over">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>

  <!-- Buttons: M3 full pill with spring press (excluding multi-line choice cards) -->
  <Style Selector="Window.material-you Button:not(.choice-card), Window.material-you ToggleButton">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.20" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.material-you Button:not(.choice-card):pointerover, Window.material-you ToggleButton:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
  <Style Selector="Window.material-you Button:not(.choice-card):pressed, Window.material-you ToggleButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)" />
  </Style>

  <!-- Multi-line Choice Cards in Material You -->
  <Style Selector="Window.material-you Button.choice-card">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="MinHeight" Value="115" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.material-you Button.choice-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.material-you Button.choice-card.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.material-you Button.choice-card.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Standard action buttons in Material You (Clear history, Export, Import, Reset, etc.) -->
  <Style Selector="Window.material-you Button:not(.accent):not(.ghost):not(.icon):not(.navlink):not(.swatch):not(.preset-pill):not(.tonal):not(.choice-card)">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.material-you Button:not(.accent):not(.ghost):not(.icon):not(.navlink):not(.swatch):not(.preset-pill):not(.tonal):not(.choice-card):pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>

  <!-- Swatch buttons for theme selection -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.swatch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.22)" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
  </Style>
  <Style Selector="Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <!-- Preset pill buttons in Theme Page -->
  <Style Selector="Button.preset-pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource SoftEase}" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.preset-pill:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.preset-pill:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>
  <Style Selector="Button.preset-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
  </Style>

  <!-- Filled Accent Button -->
  <Style Selector="Button.accent, Window.material-you Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter, Window.material-you Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter, Window.material-you Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter, Window.material-you Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
