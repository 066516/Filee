  <!-- Dropdowns (ComboBox): Material 3 container & popups -->
  <Style Selector="Window.material-you ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
  </Style>
  <Style Selector="Window.material-you ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Window.material-you ComboBox /template/ Border#PopupBorder">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
  </Style>
  <!-- Dropdown opening: smooth, flicker-free opacity fade without layout margin shifts that cause popup window resize/flicker -->
  <Style Selector="Window.material-you ComboBox[IsDropDownOpen=True] /template/ Border#PopupBorder, ComboBox[IsDropDownOpen=True] /template/ Border#PopupBorder">
    <Style.Animations>
      <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window.material-you ComboBoxItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Window.material-you ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ToggleSwitch: M3 track, knob and hover color -->
  <Style Selector="Window.material-you ToggleSwitch">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource SoftEase}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.material-you ToggleSwitch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>
