  <Style Selector="Window.material-you ToggleButton.extchip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="FontWeight" Value="Medium" />
