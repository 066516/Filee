  <Style Selector="Window.material-you NumericUpDown">
    <Style.Resources>
      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    </Style.Resources>
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="160" />
  </Style>
  <Style Selector="Window.material-you NumericUpDown:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Donut Menu Control -->
  <Style Selector="Window.material-you c|DonutMenu, c|DonutMenu.material-you">
    <Setter Property="IsMaterialYou" Value="True" />
  </Style>

  <!-- ───────── Page content fade-in (keyframes can't animate RenderTransform, so Margin slides) ───────── -->
  <Style Selector="ContentControl.page > :is(Control)">
    <Style.Animations>
      <Animation Duration="0:0:0.28" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Margin" Value="0,10,0,-10" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Margin" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ───────── History Card fade & slide animation for search filtering ───────── -->
  <Style Selector="Border.history-card">
    <Style.Animations>
      <Animation Duration="0:0:0.22" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="Margin" Value="0,8,0,-8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Margin" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ───────── Reduced motion: remove every transition and animation above ───────── -->
  <Style Selector="Window.reduced-motion :is(Button), Window.reduced-motion :is(ToggleButton), Window.reduced-motion Border.chip, Window.reduced-motion ListBoxItem, Window.reduced-motion Slider /template/ Thumb#PART_Thumb">
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Window.reduced-motion Button:pressed, Window.reduced-motion ToggleButton:pressed, Window.reduced-motion Border.chip:pointerover, Window.reduced-motion ListBox.nav ListBoxItem:pointerover, Window.reduced-motion Slider /template/ Thumb#PART_Thumb:pointerover">
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Window.reduced-motion ContentControl.page > :is(Control), Window.reduced-motion Border.history-card">
    <Style.Animations>
      <Animation Duration="0:0:0.001" FillMode="Forward">
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="Margin" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
