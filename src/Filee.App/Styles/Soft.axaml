  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox, Window.material-you NumericUpDown /template/ TextBox#PART_TextBox, NumericUpDown /template/ TextBox, ButtonSpinner TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14,0,4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:pointerover, Window.material-you NumericUpDown /template/ TextBox#PART_TextBox:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox:focus, Window.material-you NumericUpDown /template/ TextBox#PART_TextBox:focus">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="NumericUpDown:pointerover /template/ TextBox#PART_TextBox, Window.material-you NumericUpDown:pointerover /template/ TextBox#PART_TextBox, NumericUpDown /template/ TextBox#PART_TextBox:pointerover, Window.material-you NumericUpDown /template/ TextBox#PART_TextBox:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- ButtonSpinner root & repeat buttons: remove vertical divider lines and floating circles in all states -->
  <Style Selector="ButtonSpinner">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,0,6,0" />
  </Style>
  <Style Selector="ButtonSpinner /template/ Border#PART_RootBorder">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton,
                   ButtonSpinner:right /template/ RepeatButton,
                   ButtonSpinner:right /template/ RepeatButton#PART_IncreaseButton,
                   ButtonSpinner:right /template/ RepeatButton#PART_DecreaseButton,
                   ButtonSpinner /template/ RepeatButton#PART_IncreaseButton,
                   ButtonSpinner /template/ RepeatButton#PART_DecreaseButton,
                   Window.material-you ButtonSpinner /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
